# MeshMind environment template
#
# DO NOT place real secrets in this file.
# Export the settings needed by each process; files are not loaded automatically.
# The agent CLI also accepts an explicit private two-key OpenAI file.

# Phase 8 OpenAI Responses API. Export both values, or use an explicit
# private two-key file with agent_main --env-file .env.phase8.local.
# No dotenv file is loaded automatically; never put a real key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# MeshMind Control
CONTROL_HOST=
CONTROL_PORT=

# Workers
HYDRO_WORKER_URL=
FLOOD_WORKER_URL=

# Worker API authentication settings are documented below.

# Phase 4 worker APIs (export these variables before starting Uvicorn).
# Defaults point to data/cache/gpm and data/cache/smap in this checkout.
# HTTP tasks reference basenames only, never arbitrary local paths or URLs.
MESHMIND_GPM_DIR=
MESHMIND_SMAP_DIR=
MESHMIND_MAX_TASKS=128
# Optional Bearer token for both task and status routes. Never commit a real token.
MESHMIND_WORKER_TOKEN=

# Phase 5 Control dispatch: set the worker origins above explicitly.
# Example forms: http://<hydro-laptop-ip>:8002 and http://<flood-laptop-ip>:8003.
# Origin URLs cannot include credentials, paths, query strings or fragments.
# Each token must match MESHMIND_WORKER_TOKEN on that destination worker.
HYDRO_WORKER_TOKEN=
FLOOD_WORKER_TOKEN=
# Request timeout: 0.1–120 s; per-task deadline: 0.1–3600 s.
# Poll interval: 0.01–30 s. Control never silently chooses localhost.
MESHMIND_REQUEST_TIMEOUT_SECONDS=15
MESHMIND_TASK_TIMEOUT_SECONDS=600
MESHMIND_POLL_INTERVAL_SECONDS=0.5

# Optional Control-only source IP for outbound worker connections. Leave blank
# for the operating system default. Set only to a literal IP already assigned
# to this Control machine; hostnames, interface names and IPv6 scopes are invalid.
MESHMIND_CONTROL_SOURCE_IP=
